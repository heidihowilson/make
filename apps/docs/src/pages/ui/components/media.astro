---
import Base from '../../../layouts/Ui.astro';

// Demo art comes from the sethmakes-art pipeline (tools/art) — the cast
// registry rendered through the locked style block. Never stock photos.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const art = (file: string) => (base + 'art/' + file).replace(/\/+/g, '/');
---

<Base title="Media">
  <h1>Media</h1>
  <p>
    Art is always framed: a 2px ink rule, a 6px newsprint mat, and the hard
    4px letterpress offset. Full-bleed imagery is never used — the frame is
    how a picture sits on a printed page. Pending slots are dashed; nothing
    shimmers.
  </p>

  <section class="mk-card">
    <h2>FRAMED ART</h2>
    <p>
      A <code>.mk-thumb</code> mats and crops its <code>&lt;img&gt;</code>
      with <code>object-fit: cover</code>. The default window is a poster
      (2/3); <code>--square</code> is 1/1 and <code>--video</code> is 16/9.
    </p>
    <div class="row">
      <div class="ratio-cell">
        <div class="mk-thumb">
          <img src={art('portrait-ake.jpg')} alt="Ake the sysop, pressed to the glass with alarm" width="848" height="1264" loading="lazy" />
        </div>
        <p class="cap">poster · 2/3</p>
      </div>
      <div class="ratio-cell">
        <div class="mk-thumb mk-thumb--square">
          <img src={art('scene-ledger-fire.jpg')} alt="Cadbury balancing the ledger as the wastepaper basket burns" width="1024" height="1024" loading="lazy" />
        </div>
        <p class="cap">square · 1/1</p>
      </div>
      <div class="ratio-cell">
        <div class="mk-thumb mk-thumb--video">
          <img src={art('scene-config-water.jpg')} alt="Wilson filling a watering can lettered CONFIG while Ake watches with alarm" width="1376" height="768" loading="lazy" />
        </div>
        <p class="cap">video · 16/9</p>
      </div>
    </div>
    <pre><code>&lt;div class="mk-thumb"&gt;
  &lt;img src="/portrait.jpg" alt="Mr. Taylor, mid-apology" /&gt;
&lt;/div&gt;

&lt;div class="mk-thumb mk-thumb--square"&gt;…&lt;/div&gt;
&lt;div class="mk-thumb mk-thumb--video"&gt;…&lt;/div&gt;</code></pre>
  </section>

  <section class="mk-card">
    <h2>THE UNENGRAVED PORTRAIT</h2>
    <p>
      The no-image path: render <code>.mk-thumb__fallback</code> on the
      server when the portrait is missing. The frame holds a large typewriter
      initial on the plate tone — a playbill whose engraving has not come
      back from the shop. No image request, no layout shift.
    </p>
    <div class="row">
      <div class="ratio-cell">
        <div class="mk-thumb">
          <div class="mk-thumb__fallback">T</div>
        </div>
        <p class="cap">Tim Taylor</p>
      </div>
      <div class="ratio-cell">
        <div class="mk-thumb">
          <div class="mk-thumb__fallback">J</div>
        </div>
        <p class="cap">Jill Taylor</p>
      </div>
      <div class="ratio-cell">
        <div class="mk-thumb">
          <div class="mk-thumb__fallback">A</div>
        </div>
        <p class="cap">Al Borland</p>
      </div>
    </div>
    <pre><code>&lt;div class="mk-thumb"&gt;
  &lt;div class="mk-thumb__fallback"&gt;T&lt;/div&gt;
&lt;/div&gt;</code></pre>
  </section>

  <section class="mk-card">
    <h2>THE MEDALLION</h2>
    <p>
      The portrait cameo, and the one round thing in the system beside the
      radio &mdash; a circle here is geometry, not softness, because the
      engraver&rsquo;s tool is round. Three printed things, one job each: a
      2px ink ring, a 2px paper mat, and a hairline rim where the plate meets
      the mat. The five rungs are a billing order, not a size scale; set
      <code>--mk-medallion-size</code> yourself for anything between.
    </p>
    <div class="row">
      <div class="cameo-cell">
        <span class="mk-medallion mk-medallion--xs"><img src={art('portrait-seth.jpg')} alt="Seth, the operator" width="848" height="1264" loading="lazy" /></span>
        <p class="cap">xs &middot; 30px</p>
      </div>
      <div class="cameo-cell">
        <span class="mk-medallion mk-medallion--sm"><img src={art('portrait-wilson.jpg')} alt="Wilson, the neighbour" width="848" height="1264" loading="lazy" /></span>
        <p class="cap">sm &middot; 38px</p>
      </div>
      <div class="cameo-cell">
        <span class="mk-medallion mk-medallion--md"><img src={art('portrait-cadbury.jpg')} alt="Cadbury, the bookkeeper" width="848" height="1264" loading="lazy" /></span>
        <p class="cap">md &middot; 60px</p>
      </div>
      <div class="cameo-cell">
        <span class="mk-medallion mk-medallion--lg"><img src={art('portrait-ake.jpg')} alt="Ake, the sysop" width="848" height="1264" loading="lazy" /></span>
        <p class="cap">lg &middot; 78px</p>
      </div>
      <div class="cameo-cell">
        <span class="mk-medallion mk-medallion--xl"><span class="mk-medallion__initials">TT</span></span>
        <p class="cap">xl &middot; 92px</p>
      </div>
    </div>
    <pre><code>&lt;span class="mk-medallion mk-medallion--lg"&gt;
  &lt;img src="/tim.jpg" alt="Tim Taylor" /&gt;
&lt;/span&gt;

&lt;span class="mk-medallion mk-medallion--sm"&gt;
  &lt;span class="mk-medallion__initials"&gt;TT&lt;/span&gt;
&lt;/span&gt;

&lt;!-- any size, off the ladder --&gt;
&lt;span class="mk-medallion" style="--mk-medallion-size: 52px"&gt;…&lt;/span&gt;</code></pre>
  </section>

  <section class="mk-card">
    <h2>THE ENGRAVING HAS NOT COME BACK</h2>
    <p>
      The initials hold silently. There is no spinner, no
      &ldquo;generating&rdquo;, and no retry &mdash; a playbill does not
      apologise for an engraving still at the shop. When the picture arrives,
      replace the initials node with an
      <code>&lt;img class="mk-stamp-in"&gt;</code> and let it strike into
      place. That is the whole state machine.
    </p>
    <p>
      There is deliberately <strong>no <code>--pending</code> class</strong>.
      A cameo that is waiting and a cameo that will never have a portrait must
      look identical, because a difference between them would be a promise,
      and this language does not promise.
    </p>
    <div class="row">
      <div class="cameo-cell">
        <span class="mk-medallion mk-medallion--lg"><span class="mk-medallion__initials">JT</span></span>
        <p class="cap">waiting</p>
      </div>
      <div class="cameo-cell">
        <span class="mk-medallion mk-medallion--lg"><img src={art('portrait-wilson.jpg')} alt="Wilson, the living picket fence" width="848" height="1264" loading="lazy" /></span>
        <p class="cap">arrived</p>
      </div>
    </div>
    <pre><code>&lt;!-- before --&gt;
&lt;span class="mk-medallion mk-medallion--lg"&gt;
  &lt;span class="mk-medallion__initials"&gt;JT&lt;/span&gt;
&lt;/span&gt;

&lt;!-- after: the same element, the picture swaps in --&gt;
&lt;span class="mk-medallion mk-medallion--lg"&gt;
  &lt;img class="mk-stamp-in" src="/jill.jpg" alt="Jill Taylor" /&gt;
&lt;/span&gt;</code></pre>
  </section>

  <section class="mk-card">
    <h2>WHO IS ON, AND WHO IS NOT</h2>
    <p>
      One datum, printed three ways. <code>--now</code> wraps the player in a
      marquee: an ink band carrying twelve flat paper lamps. Nothing glows
      &mdash; the mock&rsquo;s blurred halos do not ship, because a 1933 press
      could not strike one. <code>--soon</code> and <code>--later</code> print
      a 4px state band at a 7px standoff of clear paper, and both
      <strong>step the cameo down one rung</strong>, so whoever is on is
      biggest without a word being read.
    </p>
    <p>
      <strong>The band is never the only carrier.</strong> Measured on the
      sheet, the soon band reads 2.43:1 and the later band 3.59:1 &mdash; band
      ratios, not text ratios, because neither ink ever sets type. Print the
      matching badge stub beside the cameo with its words in ink, exactly as
      the badges already do (WCAG 1.4.1). A band shipped without its stub
      hides the status from a low-vision reader, and no CSS can prevent that.
    </p>
    <p>
      Red is excluded on purpose: red is the letterpress STOP hue and it means
      trouble, and a player who is not ready yet is not in trouble. The
      <code>--now</code> cameos here are <strong>static</strong>, because the
      printed band already says NOW. Its two-frame chase is a separate opt-in
      modifier that spends the page&rsquo;s one idle loop &mdash; cue it on
      <a href={(base + 'ui/components/motion').replace(/\/+/g, '/')}>MOTION</a>.
    </p>
    <div class="row">
      <div class="cameo-cell">
        <span class="mk-medallion mk-medallion--lg"><img src={art('portrait-seth.jpg')} alt="Seth, the operator" width="848" height="1264" loading="lazy" /></span>
        <p class="cap">no band</p>
      </div>
      <div class="cameo-cell cameo-cell--banded">
        <span class="mk-medallion mk-medallion--lg mk-medallion--now"><img src={art('portrait-wilson.jpg')} alt="Wilson, ready now" width="848" height="1264" loading="lazy" /></span>
        <span class="mk-badge">ON NOW</span>
      </div>
      <div class="cameo-cell cameo-cell--banded">
        <span class="mk-medallion mk-medallion--lg mk-medallion--soon"><img src={art('portrait-cadbury.jpg')} alt="Cadbury, ready soon" width="848" height="1264" loading="lazy" /></span>
        <span class="mk-badge mk-badge--warning">SOON</span>
      </div>
      <div class="cameo-cell cameo-cell--banded">
        <span class="mk-medallion mk-medallion--lg mk-medallion--later"><img src={art('portrait-ake.jpg')} alt="Ake, ready later" width="848" height="1264" loading="lazy" /></span>
        <span class="mk-badge">LATER</span>
      </div>
    </div>
    <pre><code>&lt;span class="mk-medallion mk-medallion--lg mk-medallion--now"&gt;…&lt;/span&gt;
&lt;span class="mk-badge"&gt;ON NOW&lt;/span&gt;

&lt;span class="mk-medallion mk-medallion--lg mk-medallion--soon"&gt;…&lt;/span&gt;
&lt;span class="mk-badge mk-badge--warning"&gt;SOON&lt;/span&gt;

&lt;span class="mk-medallion mk-medallion--lg mk-medallion--later"&gt;…&lt;/span&gt;
&lt;span class="mk-badge"&gt;LATER&lt;/span&gt;</code></pre>
  </section>

  <section class="mk-card">
    <h2>ON THE HUB</h2>
    <p>
      Eight players, one datum each, and the hierarchy does the reading: the
      four who are on carry the marquee at full size, and the rest step down a
      rung behind their state band. The grid is page-local &mdash; the library
      styles the cameo, never the grid.
    </p>
    <div class="hub-grid">
      <div class="cameo-cell cameo-cell--banded">
        <span class="mk-medallion mk-medallion--md mk-medallion--now"><span class="mk-medallion__initials">TT</span></span>
        <span class="mk-badge mk-badge--sm">TIM &middot; ON NOW</span>
      </div>
      <div class="cameo-cell cameo-cell--banded">
        <span class="mk-medallion mk-medallion--md mk-medallion--now"><span class="mk-medallion__initials">JT</span></span>
        <span class="mk-badge mk-badge--sm">JILL &middot; ON NOW</span>
      </div>
      <div class="cameo-cell cameo-cell--banded">
        <span class="mk-medallion mk-medallion--md mk-medallion--soon"><span class="mk-medallion__initials">AB</span></span>
        <span class="mk-badge mk-badge--sm mk-badge--warning">AL &middot; SOON</span>
      </div>
      <div class="cameo-cell cameo-cell--banded">
        <span class="mk-medallion mk-medallion--md mk-medallion--later"><span class="mk-medallion__initials">WW</span></span>
        <span class="mk-badge mk-badge--sm">WILSON &middot; LATER</span>
      </div>
      <div class="cameo-cell cameo-cell--banded">
        <span class="mk-medallion mk-medallion--md mk-medallion--now"><span class="mk-medallion__initials">RT</span></span>
        <span class="mk-badge mk-badge--sm">RANDY &middot; ON NOW</span>
      </div>
      <div class="cameo-cell cameo-cell--banded">
        <span class="mk-medallion mk-medallion--md mk-medallion--soon"><span class="mk-medallion__initials">BT</span></span>
        <span class="mk-badge mk-badge--sm mk-badge--warning">BRAD &middot; SOON</span>
      </div>
      <div class="cameo-cell cameo-cell--banded">
        <span class="mk-medallion mk-medallion--md mk-medallion--now"><span class="mk-medallion__initials">MT</span></span>
        <span class="mk-badge mk-badge--sm">MARK &middot; ON NOW</span>
      </div>
      <div class="cameo-cell cameo-cell--banded">
        <span class="mk-medallion mk-medallion--md mk-medallion--later"><span class="mk-medallion__initials">HK</span></span>
        <span class="mk-badge mk-badge--sm">HEIDI &middot; LATER</span>
      </div>
    </div>
    <pre><code>/* app CSS — not shipped by the library */
.hub-grid &#123;
  display: grid;
  gap: var(--mk-space-xl) var(--mk-space-md);
  grid-template-columns: repeat(auto-fill, minmax(8rem, 1fr));
  justify-items: center;
&#125;</code></pre>
  </section>

  <section class="mk-card">
    <h2>DASHED SLOTS</h2>
    <p>
      A pending picture is a <code>.mk-skeleton</code> — a dashed plate
      meaning nothing is printed here yet. No shimmer; nothing idles in this
      language. Nest one in a thumb, or use <code>--text</code> for line
      shims.
    </p>
    <div class="row">
      <div class="ratio-cell">
        <div class="mk-thumb">
          <div class="mk-skeleton"></div>
        </div>
      </div>
      <div class="lines">
        <div class="mk-skeleton mk-skeleton--text" style="width: 70%"></div>
        <div class="mk-skeleton mk-skeleton--text" style="width: 45%"></div>
        <div class="mk-skeleton mk-skeleton--text" style="width: 90%"></div>
      </div>
    </div>
    <pre><code>&lt;div class="mk-thumb"&gt;
  &lt;div class="mk-skeleton"&gt;&lt;/div&gt;
&lt;/div&gt;

&lt;div class="mk-skeleton mk-skeleton--text" style="width: 70%"&gt;&lt;/div&gt;</code></pre>
  </section>

  <section class="mk-card">
    <h2>FIGURE WITH CAPTION</h2>
    <p>
      Wrap framed art in <code>.mk-figure</code> for a typewriter caption
      slug beneath — the way a strip panel carries its dateline.
    </p>
    <div class="row">
      <figure class="mk-figure" style="max-width: 12rem">
        <div class="mk-thumb">
          <img src={art('portrait-wilson.jpg')} alt="Wilson, the living picket fence, at his garden tap" width="848" height="1264" loading="lazy" />
        </div>
        <figcaption>MR. WILSON W. WILSON · A LIVING PICKET FENCE, AND GLAD OF IT</figcaption>
      </figure>
    </div>
    <pre><code>&lt;figure class="mk-figure"&gt;
  &lt;div class="mk-thumb"&gt;
    &lt;img src="/wilson.jpg" alt="Mr. Wilson at the fence" /&gt;
  &lt;/div&gt;
  &lt;figcaption&gt;MR. WILSON W. WILSON · AT THE FENCE&lt;/figcaption&gt;
&lt;/figure&gt;</code></pre>
  </section>

  <section class="mk-card">
    <h2>THE PORTRAIT WALL</h2>
    <p>
      Grids are the app&rsquo;s problem, not the library&rsquo;s — there is
      no <code>.mk-grid</code>. Lay frames out with your own CSS grid; the
      page-local style below is the whole recipe.
    </p>
    <div class="poster-grid">
      <div class="mk-thumb"><img src={art('portrait-seth.jpg')} alt="Seth, the operator, mid-explanation" width="848" height="1264" loading="lazy" /></div>
      <div class="mk-thumb"><img src={art('portrait-wilson.jpg')} alt="Wilson, the neighbour" width="848" height="1264" loading="lazy" /></div>
      <div class="mk-thumb"><img src={art('portrait-cadbury.jpg')} alt="Cadbury, the bookkeeper" width="848" height="1264" loading="lazy" /></div>
      <div class="mk-thumb"><img src={art('portrait-ake.jpg')} alt="Ake, the sysop" width="848" height="1264" loading="lazy" /></div>
      <div class="mk-thumb"><div class="mk-thumb__fallback">?</div></div>
      <div class="mk-thumb"><div class="mk-skeleton"></div></div>
    </div>
    <pre><code>&lt;ul class="poster-grid"&gt;
  &lt;li&gt;&lt;div class="mk-thumb"&gt;…&lt;/div&gt;&lt;/li&gt;
&lt;/ul&gt;

/* app CSS — not shipped by the library */
.poster-grid &#123;
  display: grid;
  gap: var(--mk-space-md);
  grid-template-columns: repeat(auto-fill, minmax(7rem, 1fr));
&#125;</code></pre>
  </section>

  <style>
    section.mk-card + section.mk-card {
      margin-top: var(--mk-space-2xl);
    }

    .row {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      gap: var(--mk-space-lg);
    }

    .ratio-cell {
      display: flex;
      flex-direction: column;
      gap: var(--mk-space-xs);
      width: 8rem;
    }

    .cap {
      margin: 0;
      font-family: var(--mk-font-typewriter);
      font-size: var(--mk-size-mono-xs);
      letter-spacing: 0.08em;
      color: var(--mk-color-text-muted);
    }

    .lines {
      display: flex;
      flex-direction: column;
      gap: var(--mk-space-xs);
      flex: 1;
      min-width: 12rem;
    }

    .cameo-cell {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--mk-space-xs);
      width: 8rem;
    }

    /*
     * A banded cameo needs clear paper around it: the marquee reaches 17px
     * past the ring, so the stub below it needs more than the default gap.
     */
    .cameo-cell--banded {
      gap: var(--mk-space-xl);
      padding-block: var(--mk-space-xl);
    }

    /* The hub is page-local on purpose — the library ships no grid. */
    .hub-grid {
      display: grid;
      gap: var(--mk-space-xl) var(--mk-space-md);
      grid-template-columns: repeat(auto-fill, minmax(8rem, 1fr));
      justify-items: center;
    }

    /* The portrait wall is page-local on purpose — the library ships no grid. */
    .poster-grid {
      display: grid;
      gap: var(--mk-space-md);
      grid-template-columns: repeat(auto-fill, minmax(7rem, 1fr));
    }

    pre {
      margin-top: var(--mk-space-md);
      padding: 12px 14px;
      background: var(--mk-color-plate);
      border: var(--mk-rule-hair);
      border-left: var(--mk-rule-thick);
      color: var(--mk-color-heading);
      font-family: var(--mk-font-typewriter);
      font-size: var(--mk-size-mono-sm);
      line-height: 1.6;
      overflow-x: auto;
    }

    code {
      font-family: var(--mk-font-typewriter);
      font-size: 0.86em;
      background: var(--mk-color-plate);
      border: var(--mk-rule-hair);
      color: var(--mk-color-heading);
      padding: 1px 5px 0;
    }

    pre code {
      background: none;
      border: 0;
      padding: 0;
      font-size: inherit;
    }
  </style>
</Base>
