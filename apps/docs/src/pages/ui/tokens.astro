---
import Base from '../../layouts/Ui.astro';

// Primitives — rendered here precisely because this page documents the
// primitive tier. Consuming components must never touch these; this
// reference is the one allowed exception.
const palette = [
  { var: '--mk-ink', hex: '#2a241b', note: 'the printing ink' },
  { var: '--mk-paper', hex: '#e6d9ba', note: 'the sheet' },
  { var: '--mk-paper-2', hex: '#ede2c4', note: 'panel fill' },
  { var: '--mk-paper-3', hex: '#d8c9a4', note: 'pressed fill' },
  { var: '--mk-tan', hex: '#b3a37e', note: 'the hairline' },
  { var: '--mk-brown', hex: '#5b4a33', note: 'secondary ink' },
  { var: '--mk-faded', hex: '#8f8066', note: 'sun-faded ink — line-work only' },
  { var: '--mk-faded-ink', hex: '#685d45', note: 'readable muted text (the sepia-pass darkening)' },
  { var: '--mk-ochre', hex: '#c47a2e', note: 'the ONE accent — rationed' },
  { var: '--mk-stage-floor', hex: '#26211a', note: 'the stage behind the sheet' },
  { var: '--mk-body-ink', hex: '#3a3128', note: 'prose ink' },
  { var: '--mk-link-ink', hex: '#7a4e15', note: 'link ink — deepened in the sepia pass' },
];

const faces = [
  {
    var: '--mk-font-display',
    face: 'Rye',
    job: 'mastheads, character names — never body, never a button',
    sample: 'Gholson’s Follies',
    style: 'font-family: var(--mk-font-display); font-size: var(--mk-size-dept);',
  },
  {
    var: '--mk-font-typewriter',
    face: 'Special Elite',
    job: 'datelines, nav, labels, code — the utility voice',
    sample: 'APPEARING NIGHTLY · PRICE: FREE',
    style: 'font-family: var(--mk-font-typewriter); font-size: var(--mk-size-mono); letter-spacing: var(--mk-track-mono);',
  },
  {
    var: '--mk-font-body',
    face: 'Sorts Mill Goudy',
    job: 'all prose; italic for taglines, roles, quotes',
    sample: 'A troupe of tools, appearing nightly.',
    style: 'font-family: var(--mk-font-body); font-size: var(--mk-size-body);',
  },
];

const surfaces = [
  { var: '--mk-color-stage', note: 'the page behind the sheet' },
  { var: '--mk-color-sheet', note: 'the printed sheet itself' },
  { var: '--mk-color-inset', note: 'panels, plates, form fills' },
  { var: '--mk-color-plate', note: 'pressed/active fills' },
  { var: '--mk-color-ink-surface', note: 'inverted blocks: bulletin, tooltip' },
];
const texts = [
  { var: '--mk-color-heading', note: 'headings' },
  { var: '--mk-color-text', note: 'prose' },
  { var: '--mk-color-text-secondary', note: 'taglines, datelines' },
  { var: '--mk-color-text-muted', note: 'muted text — readable faded ink' },
  { var: '--mk-color-text-on-ink', note: 'text on inverted blocks' },
];
const accents = [
  { var: '--mk-color-accent', note: 'ochre — one spot per view' },
  { var: '--mk-color-link', note: 'link ink' },
  { var: '--mk-color-link-hover', note: 'ink goes ochre — instantly' },
  { var: '--mk-color-focus', note: '2px outline, offset 3px' },
];
const statuses = [
  { var: '--mk-color-success', note: 'printed ink — a thing done needs no colour' },
  { var: '--mk-color-warning', note: 'the house ochre' },
  { var: '--mk-color-danger', note: 'letterpress red — the hue kept for STOP' },
];

const typeScale = [
  { var: '--mk-size-title', value: 'clamp(44px, 6.5vw, 78px)', note: 'Rye mastheads' },
  { var: '--mk-size-name', value: 'clamp(56px, 9vw, 96px)', note: 'Rye character names' },
  { var: '--mk-size-dept', value: '23px', note: 'typewriter department headings' },
  { var: '--mk-size-dept-sm', value: '17px', note: 'small departments' },
  { var: '--mk-size-player', value: '19px', note: 'player names' },
  { var: '--mk-size-body-lg', value: '19px', note: 'lead prose' },
  { var: '--mk-size-body', value: '18px', note: 'prose' },
  { var: '--mk-size-body-sm', value: '17px', note: 'the responsive floor' },
  { var: '--mk-size-list', value: '16px', note: 'list text' },
  { var: '--mk-size-quote', value: '20px', note: 'pull-quotes' },
  { var: '--mk-size-tagline', value: '17px', note: 'italic taglines' },
  { var: '--mk-size-mono', value: '13px', note: 'typewriter utility' },
  { var: '--mk-size-mono-sm', value: '12px', note: 'small typewriter' },
  { var: '--mk-size-mono-xs', value: '11px', note: 'the fine print' },
];

const tracks = [
  { var: '--mk-track-dept', value: '0.08em', note: 'department headings' },
  { var: '--mk-track-mono', value: '0.1em', note: 'a dateline' },
  { var: '--mk-track-nav-sm', value: '0.12em', note: 'small nav' },
  { var: '--mk-track-back', value: '0.18em', note: 'the back link' },
  { var: '--mk-track-nav', value: '0.22em', note: 'primary nav' },
  { var: '--mk-track-bill-no', value: '0.3em', note: 'bill numbers' },
  { var: '--mk-track-bulletin', value: '0.32em', note: 'the bulletin' },
  { var: '--mk-track-kicker', value: '0.4em', note: 'a proscenium announcement' },
];

const spaceScale = [
  { step: 'hair', value: '2px' },
  { step: 'xxs', value: '6px' },
  { step: 'xs', value: '10px' },
  { step: 'sm', value: '14px' },
  { step: 'md', value: '16px' },
  { step: 'inset', value: '18px' },
  { step: 'lg', value: '20px' },
  { step: 'xl', value: '26px' },
  { step: '2xl', value: '32px' },
  { step: '3xl', value: '36px' },
  { step: '4xl', value: '44px' },
  { step: '5xl', value: '48px' },
];

// The measure, icon and layer slots — small families the components and
// icons package reference; listed so this page is the full primitive map.
const misc = [
  { var: '--mk-measure-prose', value: '70ch', note: 'the prose measure' },
  { var: '--mk-icon-sm', value: '1rem', note: 'small glyph slot' },
  { var: '--mk-icon-md', value: '1.25rem', note: 'default glyph slot' },
  { var: '--mk-icon-lg', value: '1.5rem', note: 'large glyph slot' },
  { var: '--mk-layer-chrome', value: '100', note: 'app chrome' },
  { var: '--mk-layer-overlay', value: '200', note: 'dialogs and scrims' },
  { var: '--mk-layer-toast', value: '300', note: 'the telegram — above everything' },
];

const rules = [
  { var: '--mk-rule-double', note: '4px double — major section break' },
  { var: '--mk-rule-double-thin', note: '3px double — footer break' },
  { var: '--mk-rule-thick', note: '2px solid — department underline, every box' },
  { var: '--mk-rule-hair', note: '1px tan — minor division' },
  { var: '--mk-rule-dash', note: '1px dashed — nothing is printed here yet' },
  { var: '--mk-rule-accent', note: '2px ochre — spends the ration' },
];

const radii = [
  { var: '--mk-radius-control', note: '0 — square keys' },
  { var: '--mk-radius-surface', note: '0 — square panels' },
  { var: '--mk-radius-medallion', note: '50% — the circle is geometry, not softness' },
];

const shadows = [
  { var: '--mk-shadow-sheet', note: 'the deep drop — lifts the sheet off the stage, once per page' },
  { var: '--mk-shadow-block', note: 'the hard 4px letterpress offset — framed art, forms, buttons' },
  { var: '--mk-shadow-block-accent', note: 'letterpress offset in ochre' },
  { var: '--mk-shadow-press', note: 'the pressed variant — a key held down' },
];

const motions = [
  { var: '--mk-frame', value: '83ms', note: 'one drawing at 12fps' },
  { var: '--mk-dur-beat', value: '250ms', note: '3 frames — small entrances' },
  { var: '--mk-dur-enter', value: '420ms', note: '5 frames — sheet/art entrances' },
  { var: '--mk-dur-reveal', value: '660ms', note: '8 frames — iris, curtain' },
  { var: '--mk-steps-3', value: 'steps(3, end)', note: 'stepped timing' },
  { var: '--mk-steps-5', value: 'steps(5, end)', note: 'stepped timing' },
  { var: '--mk-steps-8', value: 'steps(8, end)', note: 'stepped timing' },
  { var: '--mk-dur-key', value: '90ms', note: 'the struck typewriter key' },
  { var: '--mk-ease-key', value: 'cubic-bezier(0.2, 0.7, 0.3, 1)', note: 'the one smooth easing — mechanical, not animated' },
];
---

<Base title="Tokens">
  <h1>Tokens</h1>
  <p class="prose">
    Two tiers — primitives feed semantic tokens; components reference
    semantic only. <strong>Single mode by design:</strong> the sheet-on-stage
    is the mode, and there is no dark variant of a printed page. What you see
    below is what every viewer sees.
  </p>

  <section class="mk-card" aria-labelledby="palette">
    <h2 id="palette">THE PALETTE</h2>
    <p class="prose">
      Sepia duotone — warm ink on aged newsprint, on a dark stage. Ochre is
      the only warm accent in the world, and it is rationed to one spot per
      view.
    </p>
    <ul class="ramp">
      {palette.map((t) => (
        <li class="ramp__row">
          <span class="ramp__swatch" style={`background: var(${t.var});`}></span>
          <code class="ramp__name">{t.var}</code>
          <span class="ramp__note">{t.hex} · {t.note}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="mk-card" aria-labelledby="faces">
    <h2 id="faces">THE THREE FACES</h2>
    <p class="prose">
      Each face has one job. Loudness is dialled with face, size and
      tracking, never weight — everything ships at 400.
    </p>
    <ul class="faces">
      {faces.map((f) => (
        <li class="faces__row">
          <span class="faces__sample" style={f.style}>{f.sample}</span>
          <code class="faces__name">{f.var}</code>
          <span class="faces__note">{f.face} — {f.job}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="mk-card" aria-labelledby="semantic">
    <h2 id="semantic">SEMANTIC COLORS</h2>
    <p class="prose">What components actually reference.</p>

    <h3>Surfaces</h3>
    <ul class="ramp">
      {surfaces.map((t) => (
        <li class="ramp__row">
          <span class="ramp__swatch" style={`background: var(${t.var});`}></span>
          <code class="ramp__name">{t.var}</code>
          <span class="ramp__note">{t.note}</span>
        </li>
      ))}
    </ul>

    <h3>Text</h3>
    <ul class="ramp">
      {texts.map((t) => (
        <li class="ramp__row">
          <span class="ramp__swatch" style={`background: var(${t.var});`}></span>
          <code class="ramp__name">{t.var}</code>
          <span class="ramp__note">{t.note}</span>
        </li>
      ))}
    </ul>

    <h3>Accent &amp; links</h3>
    <ul class="ramp">
      {accents.map((t) => (
        <li class="ramp__row">
          <span class="ramp__swatch" style={`background: var(${t.var});`}></span>
          <code class="ramp__name">{t.var}</code>
          <span class="ramp__note">{t.note}</span>
        </li>
      ))}
    </ul>

    <h3>Status</h3>
    <ul class="ramp">
      {statuses.map((t) => (
        <li class="ramp__row">
          <span class="ramp__swatch" style={`background: var(${t.var});`}></span>
          <code class="ramp__name">{t.var}</code>
          <span class="ramp__note">{t.note}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="mk-card" aria-labelledby="type">
    <h2 id="type">TYPE SCALE</h2>
    <p class="prose">A specimen at each step; the note names the face it serves.</p>
    <ul class="specimen">
      {typeScale.map((t) => (
        <li class="specimen__row">
          <span class="specimen__text" style={`font-size: var(${t.var});`}>Aa on the bill</span>
          <code class="specimen__name">{t.var}</code>
          <span class="specimen__note">{t.value} · {t.note}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="mk-card" aria-labelledby="tracking">
    <h2 id="tracking">TRACKING</h2>
    <p class="prose">
      The typewriter&rsquo;s loudness dial: .08em is a department heading,
      .4em is a proscenium announcement.
    </p>
    <ul class="specimen">
      {tracks.map((t) => (
        <li class="specimen__row">
          <span class="specimen__track" style={`letter-spacing: var(${t.var});`}>APPEARING NIGHTLY</span>
          <code class="specimen__name">{t.var}</code>
          <span class="specimen__note">{t.value} · {t.note}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="mk-card" aria-labelledby="space">
    <h2 id="space">SPACING RHYTHM</h2>
    <p class="prose">
      The source works in a 2/6/10/14/16/18/20/26/32/36/44/48 rhythm, not a
      4/8 grid — the print rhythm is the rhythm. Do not snap it.
    </p>
    <ul class="bars">
      {spaceScale.map((s) => (
        <li class="bars__row">
          <span class="bars__bar" style={`inline-size: var(--mk-space-${s.step});`}></span>
          <code class="bars__name">--mk-space-{s.step}</code>
          <span class="bars__note">{s.value}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="mk-card" aria-labelledby="misc">
    <h2 id="misc">MEASURE, ICON SLOTS &amp; LAYERS</h2>
    <p class="prose">
      The small families: the prose measure, the glyph slots the icons
      package aligns to, and the named layers so nothing ever types
      <code>z-index: 9999</code>.
    </p>
    <div class="mk-table-wrap">
      <table class="mk-table">
        <thead>
          <tr>
            <th>TOKEN</th>
            <th>VALUE</th>
            <th>MEANING</th>
          </tr>
        </thead>
        <tbody>
          {misc.map((t) => (
            <tr>
              <td><code>{t.var}</code></td>
              <td class="mk-table__num"><code>{t.value}</code></td>
              <td>{t.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="mk-card" aria-labelledby="rules">
    <h2 id="rules">RULES</h2>
    <p class="prose">
      Rules do the dividing — hierarchy is printed, not floated. Grab a
      whole rule, not a width, and pick it for the meaning, not the look.
    </p>
    <ul class="rules">
      {rules.map((t) => (
        <li class="rules__row">
          <span class="rules__line" style={`border-top: var(${t.var});`}></span>
          <code class="rules__name">{t.var}</code>
          <span class="rules__note">{t.note}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="mk-card" aria-labelledby="radius">
    <h2 id="radius">RADIUS</h2>
    <p class="prose">
      Zero. The only round things in the system are the portrait medallion
      and the radio control. The slots stay so nothing hardcodes a corner.
    </p>
    <ul class="rows">
      {radii.map((t) => (
        <li class="rows__row">
          <code class="rows__name">{t.var}</code>
          <span class="rows__demo" style={`border-radius: var(${t.var});`}></span>
          <span class="rows__note">{t.note}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="mk-card" aria-labelledby="shadows">
    <h2 id="shadows">SHADOWS</h2>
    <p class="prose">
      Exactly two, plus a pressed variant. No blur on blocks, no ambient
      shadows, no elevation scale.
    </p>
    <ul class="rows rows--roomy">
      {shadows.map((t) => (
        <li class="rows__row">
          <code class="rows__name">{t.var}</code>
          <span class="rows__demo rows__demo--paper" style={`box-shadow: var(${t.var});`}></span>
          <span class="rows__note">{t.note}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="mk-card" aria-labelledby="motion">
    <h2 id="motion">MOTION</h2>
    <p class="prose">
      Shot on twos — stepped at 12 drawings a second, never smoothly eased.
      Motion is an event (an overlay entering, a telegram arriving), never a
      state; nothing animates on scroll or hover, so nothing here moves.
    </p>
    <div class="mk-table-wrap">
      <table class="mk-table">
        <thead>
          <tr>
            <th>TOKEN</th>
            <th>VALUE</th>
            <th>MEANING</th>
          </tr>
        </thead>
        <tbody>
          {motions.map((t) => (
            <tr>
              <td><code>{t.var}</code></td>
              <td><code>{t.value}</code></td>
              <td>{t.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <style>
    section + section {
      margin-top: var(--mk-space-2xl);
    }

    .prose {
      max-width: var(--mk-measure-prose);
    }

    .mk-card h3 {
      margin-top: var(--mk-space-xl);
    }

    .ramp,
    .specimen,
    .faces,
    .bars,
    .rules,
    .rows {
      list-style: none;
      margin: var(--mk-space-sm) 0 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: var(--mk-space-xs);
    }

    .ramp__row,
    .bars__row,
    .rules__row,
    .rows__row {
      display: flex;
      align-items: center;
      gap: var(--mk-space-sm);
      flex-wrap: wrap;
    }

    /* Swatches take the 2px ink rule — a boxed specimen, letterpress style. */
    .ramp__swatch {
      inline-size: 3rem;
      block-size: 2rem;
      flex: none;
      border: var(--mk-rule-thick);
    }

    .ramp__name,
    .bars__name,
    .rules__name,
    .rows__name,
    .specimen__name,
    .faces__name {
      font-size: var(--mk-size-mono-xs);
      color: var(--mk-color-text-secondary);
    }

    .ramp__note,
    .rules__note,
    .rows__note,
    .specimen__note,
    .bars__note,
    .faces__note {
      font-family: var(--mk-font-body);
      font-style: italic;
      font-size: var(--mk-size-body-sm);
      color: var(--mk-color-text-muted);
    }

    .rows__name {
      inline-size: 13rem;
      flex: none;
    }

    .faces__row {
      display: flex;
      flex-direction: column;
      gap: var(--mk-space-hair);
      padding-block: var(--mk-space-xs);
    }

    .faces__row + .faces__row {
      border-top: var(--mk-rule-hair);
    }

    .faces__sample {
      color: var(--mk-color-heading);
      line-height: var(--mk-leading-tight);
    }

    .specimen__row {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: var(--mk-space-xxs) var(--mk-space-md);
    }

    .specimen__text {
      line-height: var(--mk-leading-tight);
    }

    .specimen__track {
      font-family: var(--mk-font-typewriter);
      font-size: var(--mk-size-mono-sm);
      color: var(--mk-color-heading);
      white-space: nowrap;
    }

    .bars__bar {
      block-size: 1rem;
      flex: none;
      background: var(--mk-color-heading);
    }

    .rules__line {
      inline-size: 6rem;
      flex: none;
    }

    .rows__demo {
      inline-size: 2.5rem;
      block-size: 2.5rem;
      flex: none;
      background: var(--mk-color-plate);
      border: var(--mk-rule-thick);
    }

    /* Shadow demos sit on paper with room for the drop. */
    .rows--roomy {
      gap: var(--mk-space-lg);
    }

    .rows__demo--paper {
      background: var(--mk-color-sheet);
      margin: var(--mk-space-xxs);
    }
  </style>
</Base>
