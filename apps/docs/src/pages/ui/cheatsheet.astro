---
import Base from '../../layouts/Ui.astro';

// The one-page class inventory. Born from consumer #2's meta-feedback: "the
// library keeps turning out to already have the thing; discoverability is
// the gap, not coverage." If a class isn't on this page, it doesn't exist.
const groups = [
  {
    area: 'PAGE',
    base: '.mk-stage + .mk-sheet',
    items: [
      ['.mk-stage > .mk-sheet', 'the sheet on the stage floor — once per page, lifted by the one deep shadow'],
      ['.mk-kicker', 'the typewriter announcement voice — ALL CAPS in the markup'],
    ],
  },
  {
    area: 'BUTTONS',
    base: '.mk-btn',
    items: [
      ['--primary', 'solid ink — the one hero action'],
      ['--ghost', 'a nav link in key form'],
      ['--danger', 'letterpress red — destructive'],
      ['--warning', 'the ochre plate — spends the view’s accent ration'],
      ['--active', 'held down — pair with aria-pressed'],
      ['--sm / --xs / --lg', 'sizes; xs is sub-44px, pointer-dense UIs only'],
      ['--block', 'full width'],
      ['--icon', 'square, single glyph — always aria-label; disabled copy is “SOLD OUT”'],
    ],
  },
  {
    area: 'BADGES',
    base: '.mk-badge',
    items: [
      ['--accent / --warning / --danger', 'status stubs; --accent and --warning spend the ochre ration'],
      ['--success', 'solid ink — a thing done needs no colour'],
      ['--sm', 'dense rows — tighter padding, same type size'],
      ['--dot', 'leading status dot in currentColor'],
    ],
  },
  {
    area: 'FORMS',
    base: '.mk-field',
    items: [
      ['.mk-field > label / __help / __error / --error', 'scaffolding; labels are typewriter caps'],
      ['.mk-input / .mk-select / .mk-textarea', 'ruled controls on the inset fill'],
      ['.mk-fieldset', 'native-chrome reset, legend as label'],
      ['.mk-choice', 'tap row wrapping a control'],
      ['.mk-checkbox / .mk-radio / .mk-switch', 'the stamped X, the one round control, the stage lever'],
      [':checked / [aria-checked="true"] / --checked', 'three ways to be checked — input, widget role, or server-rendered static'],
    ],
  },
  {
    area: 'SURFACES',
    base: '.mk-card',
    items: [
      ['(base)', 'a PANEL — 2px ink rule around an inset newsprint fill'],
      ['--sunken', 'the quiet panel — 1px tan hairline, transparent fill'],
      ['--flush', 'no padding; framed art meets the rule edge-to-edge'],
      ['.mk-table + .mk-table-wrap / __num', 'the ledger + mobile scroll wrapper'],
      ['.mk-divider', 'printed rules: --double (4px, major break) / --double-thin (3px, footer) / --thick (2px, department) / --dash (not printed yet) / --accent / --label (typewriter slug on hairlines); default is the 1px tan minor division'],
      ['.mk-disclosure / __body', 'programme notes — styled details/summary'],
    ],
  },
  {
    area: 'CHROME',
    base: '.mk-appbar',
    items: [
      ['(base)', 'the ruled nav rail — NOT sticky; nothing in the language is fixed'],
      ['--bottom', 'bottom-edge rail, safe-area padded'],
      ['.mk-shell / __main', 'the appbar’s document contract — full-height column so a bottom rail pins'],
    ],
  },
  {
    area: 'OVERLAYS',
    base: '.mk-dialog',
    items: [
      ['__title / __actions, ::backdrop scrim', 'native <dialog> as a playbill; the warm scrim dims the stage; app calls showModal() — demoed on FEEDBACK'],
      ['.mk-toast / --success / --warning / --danger', 'a telegram slip at the footlights — fixed bottom-center, one at a time, app brings the timer — demoed on FEEDBACK'],
      ['.mk-tabs / __tab', 'departments on a rule; selected via aria-selected / aria-current / --active — demoed on SURFACES'],
    ],
  },
  {
    area: 'FEEDBACK',
    base: '.mk-alert',
    items: [
      ['__title, --info / --success / --warning / --danger', 'a notice from the management'],
      ['.mk-spinner', 'typewriter typing dots — there are no spinners, only “. . .” struck one at a time'],
      ['.mk-spinner--sm / --md', 'smaller dot sizes'],
      ['.mk-progress / --sm', 'ink fill in a ruled trough; no value attr = the marching-hatch indeterminate'],
      ['.mk-empty / __title / __message / __action', 'the dashed tile — “nothing is printed here yet”; speak in character: “No. 2 — coming soon”'],
    ],
  },
  {
    area: 'MEDIA',
    base: '.mk-thumb',
    items: [
      ['--square / --video', 'aspect variants (default poster 2/3)'],
      ['__fallback', 'server-rendered initial, scales to its box'],
      ['.mk-skeleton / --text', 'dashed “not printed yet” slots — no shimmer'],
      ['.mk-figure', 'framed media + muted caption'],
    ],
  },
  {
    area: 'PROSE',
    base: '.mk-prose',
    items: [['(wrapper)', 'Goudy long-form at 70ch: lists, typewriter code, ruled pull-quote, kbd']],
  },
  {
    area: 'MOTION',
    base: '.mk-iris-in',
    // Every class replays live on the MOTION department page.
    items: [
      ['.mk-iris-in / .mk-curtain-in', 'the silent-film reveals — one art reveal per page'],
      ['.mk-settle-in / .mk-drop-in / .mk-stamp-in', 'entrances that land hard and hold the frame'],
      ['.mk-typeline', 'text struck onto the page'],
      ['.mk-flicker', 'the one idle loop — the marquee flicker, once per page'],
      ['.mk-bill-order', 'stagger parent — children enter in billing order'],
    ],
  },
  {
    area: 'UTILITIES',
    base: '.mk-icon',
    items: [
      ['--sm / --lg', 'sizes the glyph in an icon position — there is no line-icon set; Unicode glyphs (← → ·) do the work'],
      ['.mk-link-reset', 'composite links (nav, card-as-link, logo) opt out of the link ink'],
    ],
  },
];
---

<Base title="Cheatsheet">
  <h1>Cheatsheet</h1>
  <p class="prose">
    The complete class inventory on one page — if it isn&rsquo;t here, it
    doesn&rsquo;t exist. Each department page has rendered examples; this is
    for finding the thing you suspect already exists (it usually does).
    One reminder before you copy anything: <strong>single mode.</strong>
    There is no dark mode, no theme switcher, no
    <code>[data-theme]</code> — the sheet-on-stage is the mode.
  </p>

  <section class="mk-card sheet">
    <h2>THE PAGE</h2>
    <p class="sheet__base">every view is a sheet of newsprint on the stage floor</p>
    <pre><code>&lt;body&gt;
  &lt;div class="mk-stage"&gt;
    &lt;div class="mk-sheet"&gt;
      &lt;h1&gt;Gholson&amp;rsquo;s Follies&lt;/h1&gt;
      &lt;hr class="mk-divider mk-divider--double" /&gt;
      …
    &lt;/div&gt;
  &lt;/div&gt;
&lt;/body&gt;</code></pre>
  </section>

  {groups.map((g) => (
    <section class="mk-card sheet">
      <h2>{g.area}</h2>
      <p class="sheet__base"><code>{g.base}</code></p>
      <dl class="sheet__list">
        {g.items.map(([cls, what]) => (
          <div class="sheet__row">
            <dt><code>{cls}</code></dt>
            <dd>{what}</dd>
          </div>
        ))}
      </dl>
    </section>
  ))}

  <style>
    .prose {
      max-width: var(--mk-measure-prose);
    }

    .sheet {
      margin-top: var(--mk-space-md);
    }

    .sheet__base {
      font-family: var(--mk-font-body);
      font-style: italic;
      color: var(--mk-color-text-secondary);
      font-size: var(--mk-size-body-sm);
    }

    .sheet__list {
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: var(--mk-space-xs);
    }

    .sheet__row {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--mk-space-hair) var(--mk-space-md);
    }

    .sheet__row dt code {
      font-size: var(--mk-size-mono-sm);
    }

    .sheet__row dd {
      margin: 0;
      color: var(--mk-color-text-muted);
      font-size: var(--mk-size-body-sm);
    }

    /* Minor divisions between rows — the hairline earns its keep here. */
    .sheet__row + .sheet__row {
      border-top: var(--mk-rule-hair);
      padding-top: var(--mk-space-xs);
    }

    pre {
      overflow-x: auto;
    }

    @media (min-width: 740px) {
      .sheet__row {
        grid-template-columns: 22rem 1fr;
      }
    }
  </style>
</Base>
