---
import Base from '../../layouts/Icons.astro';

// The icon DISCOVERY TOOL — the reason this section exists. A fast, searchable
// browser over Lucide (~1770), Phosphor regular (~1530), and the mk brand
// aliases (~32). Performance is a requirement: NO SVGs are inlined into this
// HTML. Each tab's data is a trimmed JSON asset (names + svg bodies), built at
// /icons/data/<set>.json, fetched on demand and cached in memory. Search is
// debounced and results are capped (~120) with a "show more" — so the page is
// interactive instantly on a phone regardless of set size.

// BASE_URL-aware so it works under the GitHub Pages subpath. The client reads
// this off a data attribute rather than hardcoding "/".
// Normalize: Astro's BASE_URL has no trailing slash when base is '/make',
// and base+path without a separator produced /makeicons/... 404s in prod.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const dataUrl = (set: string) => (base + `icons/data/${set}.json`).replace(/\/+/g, '/');
---

<Base title="browse">
  <header class="hero">
    <h1>Browse icons</h1>
    <p class="hero__lede">
      The catalogue for consuming apps — search every glyph,
      <strong>click to copy</strong> its Tailwind class.
    </p>
  </header>

  <div
    class="browse"
    data-lucide={dataUrl('lucide')}
    data-ph={dataUrl('ph')}
    data-mk={dataUrl('mk')}
  >
    <!-- Set tabs. Buttons in a tablist on the ink rule; mk is the default
         (smallest, brand-most-relevant, instant). -->
    <div class="mk-tabs browse__tabs" role="tablist" aria-label="Icon set">
      <button class="mk-tabs__tab" role="tab" aria-selected="true" data-set="mk" id="tab-mk" aria-controls="results">MK</button>
      <button class="mk-tabs__tab" role="tab" aria-selected="false" data-set="lucide" id="tab-lucide" aria-controls="results">LUCIDE</button>
      <button class="mk-tabs__tab" role="tab" aria-selected="false" data-set="ph" id="tab-ph" aria-controls="results">PHOSPHOR</button>
    </div>

    <!-- Search. Labeled (the typewriter label is the .mk-field default),
         autofocus is applied by JS on desktop only to avoid yanking the
         viewport on phones. -->
    <div class="mk-field browse__search">
      <label for="icon-search">SEARCH THE CATALOGUE</label>
      <input
        class="mk-input"
        type="search"
        id="icon-search"
        placeholder="search by name…"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        enterkeyhint="search"
      />
    </div>

    <p class="browse__count" id="result-count" aria-live="polite">SETTING THE TYPE…</p>

    <!-- Results grid. Buttons only — keyboard accessible, visible focus. The
         grid is responsive from 360px via min-width queries. -->
    <div class="browse__grid" id="results" role="region" aria-label="Icon results"></div>

    <!-- Empty state, shown when a search matches nothing. -->
    <div class="mk-empty browse__empty" id="empty" hidden>
      <p class="mk-empty__title">NOTHING ON THE BILL</p>
      <p class="mk-empty__message">No glyph in this set answers to that name. Try a shorter term or another department.</p>
    </div>

    <!-- Show-more reveals the next page of capped results. -->
    <div class="browse__more" id="more-wrap" hidden>
      <button class="mk-btn" id="show-more" type="button">SHOW MORE</button>
    </div>

    <!-- Polite live region for copy confirmation (announced to screen readers,
         separate from the visual toast so the announcement is text-only). -->
    <p class="browse__sr" id="copy-status" role="status" aria-live="polite"></p>
  </div>

  <!-- Visual copy confirmation — a telegram slip at the footlights.
       aria-hidden — the live region above carries the accessible
       announcement. -->
  <div class="mk-toast" id="toast" aria-hidden="true" hidden></div>

  <style>
    /* Layout only — the look comes from the library classes and tokens. */
    .hero {
      padding-block: var(--mk-space-lg) var(--mk-space-xl);
    }

    .hero__lede {
      font-family: var(--mk-font-body);
      font-style: italic;
      font-size: var(--mk-size-body-lg);
      color: var(--mk-color-text-secondary);
      max-width: 44ch;
    }

    .hero__lede strong {
      color: var(--mk-color-heading);
    }

    /* Tabs + toast come from the library (.mk-tabs / .mk-toast). */
    .browse__tabs {
      margin-bottom: var(--mk-space-md);
    }

    /* Visible focus — the 2px ochre outline, the house focus treatment.
       (Focus IS the view's accent spend on this page; the copied flash
       below stays in ink for that reason.) */
    .mk-tabs__tab:focus-visible,
    .browse__cell:focus-visible,
    #show-more:focus-visible {
      outline: 2px solid var(--mk-color-focus);
      outline-offset: 3px;
    }

    .browse__search {
      margin-bottom: var(--mk-space-xs);
    }

    /* The running count — a typewriter dateline under the search slot. */
    .browse__count {
      font-family: var(--mk-font-typewriter);
      font-size: var(--mk-size-mono-xs);
      letter-spacing: var(--mk-track-mono);
      color: var(--mk-color-text-muted);
      margin-bottom: var(--mk-space-md);
      min-height: 1.2em; /* reserve space so the grid doesn't jump on update */
    }

    /* Results grid — auto-fill from 360px. Each cell is a specimen slot in
       the type tray: hairline rule (minor division), inset paper fill. */
    .browse__grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(5rem, 1fr));
      gap: var(--mk-space-xxs);
    }

    .browse__cell {
      appearance: none;
      border: var(--mk-rule-hair);
      border-radius: var(--mk-radius-control);
      background: var(--mk-color-inset);
      color: var(--mk-color-text);
      font: inherit;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      gap: var(--mk-space-xxs);
      /* Even padding all around — names clamp instead of crowding the edges. */
      padding: var(--mk-space-xs);
      min-height: 44px;
      text-align: center;
    }

    /* Hover darkens to the pressed-plate fill — instantly; ink either is
       or isn't. No transitions: motion is an event, never a hover state. */
    .browse__cell:hover {
      background: var(--mk-color-plate);
    }

    /* The glyph — heading ink, standalone-affordance size. The svg inside is
       set to 1em by iconToSVG, so font-size drives it. */
    .browse__glyph {
      font-size: var(--mk-icon-lg);
      line-height: 0;
      color: var(--mk-color-heading);
    }

    .browse__glyph svg {
      display: block;
      width: 1em;
      height: 1em;
    }

    /*
     * Name beneath — typewriter, xs, muted. Clamped to exactly two lines AND
     * reserving two lines, so every cell is the same height whether its
     * name is "x" or "calendar-arrow-down" — uneven cells read as missing
     * padding. Full name lives in the title attribute.
     */
    .browse__name {
      font-family: var(--mk-font-typewriter);
      font-size: var(--mk-size-mono-xs);
      color: var(--mk-color-text-muted);
      max-width: 100%;
      overflow-wrap: anywhere;
      line-height: var(--mk-leading-tight);
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      min-height: calc(2 * var(--mk-leading-tight) * 1em);
    }

    /* The just-copied cell reads as stamped: solid ink slug, paper text.
       Ink, not ochre — the focus ring already spends this view's accent. */
    .browse__cell--copied {
      background: var(--mk-color-ink-surface);
      border-color: var(--mk-color-ink-surface);
    }

    .browse__cell--copied .browse__glyph,
    .browse__cell--copied .browse__name {
      color: var(--mk-color-text-on-ink);
    }

    .browse__empty {
      margin-top: var(--mk-space-md);
    }

    .browse__more {
      margin-top: var(--mk-space-lg);
      display: flex;
      justify-content: center;
    }

    /* Screen-reader-only live region — visually hidden, still announced. */
    .browse__sr {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
      border: 0;
    }

    /* The copied class in the telegram, set in typewriter. */
    .mk-toast code {
      font-family: var(--mk-font-typewriter);
      font-size: var(--mk-size-mono);
    }

    /* Roomier cells once there's width to spare. min-width queries only. */
    @media (min-width: 30rem) {
      .browse__grid {
        grid-template-columns: repeat(auto-fill, minmax(6rem, 1fr));
        gap: var(--mk-space-xs);
      }
    }
  </style>

  <script>
    // All client logic for the browser. Vanilla — this is the docs app, where
    // JS is allowed; the LIBRARY itself stays zero-JS. Per-tab data is fetched
    // once and cached in memory; search is debounced; results are capped.
    (() => {
      const root = document.querySelector<HTMLElement>('.browse');
      if (!root) return;

      const grid = document.getElementById('results') as HTMLElement;
      const countEl = document.getElementById('result-count') as HTMLElement;
      const emptyEl = document.getElementById('empty') as HTMLElement;
      const moreWrap = document.getElementById('more-wrap') as HTMLElement;
      const moreBtn = document.getElementById('show-more') as HTMLButtonElement;
      const input = document.getElementById('icon-search') as HTMLInputElement;
      const srStatus = document.getElementById('copy-status') as HTMLElement;
      const toast = document.getElementById('toast') as HTMLElement;
      const tabs = Array.from(
        root.querySelectorAll<HTMLButtonElement>('.mk-tabs__tab'),
      );

      const PAGE = 120; // visible-result cap; "show more" adds another page
      const DEBOUNCE = 150;

      const urls: Record<string, string> = {
        mk: root.dataset.mk || '',
        lucide: root.dataset.lucide || '',
        ph: root.dataset.ph || '',
      };

      // In-memory cache: set -> { vb, names[], icons{} } once fetched.
      const cache: Record<string, any> = {};

      let activeSet = 'mk';
      let query = '';
      let filtered: string[] = []; // names matching current query, in set order
      let shown = 0; // how many of `filtered` are currently rendered

      // Build one icon cell as a <button>. The svg body comes from the trimmed
      // asset; viewBox is the per-icon override or the set default.
      function makeCell(set: string, name: string, data: any): HTMLButtonElement {
        const entry = data.icons[name];
        const vb = entry.v || data.vb || '0 0 24 24';
        const cls = `icon-[${set}--${name}]`;

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'browse__cell';
        btn.dataset.cls = cls;
        // Accessible name = the Tailwind class users are copying.
        btn.setAttribute('aria-label', `Copy ${cls}`);
        if (set === 'mk' && entry.src) {
          btn.title = `${cls} → ${entry.src}\n${entry.why || ''}`.trim();
        } else {
          btn.title = cls;
        }

        const glyph = document.createElement('span');
        glyph.className = 'browse__glyph';
        glyph.setAttribute('aria-hidden', 'true');
        // Bodies are trusted, static, build-generated Iconify output.
        glyph.innerHTML = `<svg viewBox="${vb}" fill="currentColor" xmlns="http://www.w3.org/2000/svg">${entry.b}</svg>`;

        const label = document.createElement('span');
        label.className = 'browse__name';
        label.textContent = name;

        btn.append(glyph, label);
        return btn;
      }

      // Render the next page of `filtered` into the grid (appends; never clears
      // mid-page so "show more" is cheap).
      function renderPage() {
        const data = cache[activeSet];
        const frag = document.createDocumentFragment();
        const end = Math.min(shown + PAGE, filtered.length);
        for (let i = shown; i < end; i++) {
          frag.appendChild(makeCell(activeSet, filtered[i], data));
        }
        grid.appendChild(frag);
        shown = end;
        moreWrap.hidden = shown >= filtered.length;
      }

      // Recompute the filtered list for the current query + set, reset paging.
      // The count line is typewriter utility text, so it speaks in caps.
      function applyFilter() {
        const data = cache[activeSet];
        if (!data) return;
        const q = query.trim().toLowerCase();
        const names = data.names as string[];
        filtered = q ? names.filter((n) => n.includes(q)) : names;

        grid.innerHTML = '';
        shown = 0;

        const total = (names as string[]).length;
        if (filtered.length === 0) {
          emptyEl.hidden = false;
          moreWrap.hidden = true;
          countEl.textContent = `0 OF ${total} GLYPHS`;
          return;
        }
        emptyEl.hidden = true;
        countEl.textContent = `${filtered.length} OF ${total} GLYPHS`;
        renderPage();
      }

      // Fetch + cache a set's trimmed JSON, then apply the current filter.
      async function loadSet(set: string) {
        if (cache[set]) {
          applyFilter();
          return;
        }
        countEl.textContent = 'SETTING THE TYPE…';
        grid.innerHTML = '';
        emptyEl.hidden = true;
        moreWrap.hidden = true;
        try {
          const res = await fetch(urls[set]);
          if (!res.ok) throw new Error(String(res.status));
          const data = await res.json();
          // Precompute the name list once (set order) for fast filtering.
          data.names = Object.keys(data.icons);
          cache[set] = data;
          applyFilter();
        } catch {
          countEl.textContent = 'THE CATALOGUE DID NOT ARRIVE · TRY REFRESHING';
        }
      }

      // Copy a Tailwind class to the clipboard with visual + SR confirmation.
      async function copyClass(btn: HTMLButtonElement) {
        const cls = btn.dataset.cls || '';
        try {
          await navigator.clipboard.writeText(cls);
        } catch {
          // Fallback for older / insecure contexts.
          const ta = document.createElement('textarea');
          ta.value = cls;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand('copy'); } catch { /* give up quietly */ }
          ta.remove();
        }

        // Visual stamp on the cell.
        btn.classList.add('browse__cell--copied');
        window.setTimeout(() => btn.classList.remove('browse__cell--copied'), 700);

        // The telegram slip. Hide, reflow, show — restarts the stepped
        // entrance (a new telegram replaces the old, it never lingers).
        toast.hidden = true;
        toast.innerHTML = `COPIED · <code>${cls}</code>`;
        void toast.offsetWidth;
        toast.hidden = false;
        window.clearTimeout((copyClass as any)._t);
        (copyClass as any)._t = window.setTimeout(() => { toast.hidden = true; }, 1600);

        // Accessible announcement (text-only, separate node).
        srStatus.textContent = `Copied ${cls}`;
      }

      // --- wiring ---

      // Tab switching.
      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          if (tab.dataset.set === activeSet) return;
          tabs.forEach((t) => {
            t.setAttribute('aria-selected', t === tab ? 'true' : 'false');
          });
          activeSet = tab.dataset.set || 'mk';
          loadSet(activeSet);
        });
      });

      // Debounced search.
      let debounce: number | undefined;
      input.addEventListener('input', () => {
        window.clearTimeout(debounce);
        debounce = window.setTimeout(() => {
          query = input.value;
          applyFilter();
        }, DEBOUNCE);
      });

      // Show more.
      moreBtn.addEventListener('click', () => renderPage());

      // Copy on cell click (event-delegated — one listener for all cells).
      grid.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.browse__cell');
        if (btn) copyClass(btn);
      });

      // Autofocus the search on desktop only — pointer:fine + no touch — so a
      // phone keyboard never pops up over the grid on load.
      const isDesktop = window.matchMedia('(pointer: fine)').matches
        && !window.matchMedia('(pointer: coarse)').matches;
      if (isDesktop) input.focus();

      // Kick off with the default (mk) set.
      loadSet(activeSet);
    })();
  </script>
</Base>
