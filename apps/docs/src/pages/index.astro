---
import Base from '../layouts/Base.astro';

// Normalize: Astro's BASE_URL has no trailing slash when base is '/make',
// and base+path without a separator produced /makeicons/... 404s in prod.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const link = (path: string) => (base + path.replace(/^\//, '')).replace(/\/+/g, '/');
const art = (file: string) => link('/art/' + file);

// The bill — every act currently booked. Numbered like a programme.
const tools = [
  {
    no: 'NO. 1',
    name: 'sethmakes-ui',
    href: '/ui',
    status: 'NOW SHOWING',
    role: 'framework-neutral components & design tokens',
    desc: 'One design language — sepia ink on aged newsprint — printed the same way in every production.',
  },
  {
    no: 'NO. 2',
    name: 'sethmakes-icons',
    href: '/icons',
    status: 'NOW SHOWING',
    role: 'a thin Iconify wrapper',
    desc: 'Icon selection happens at your build, never behind a toolkit release.',
  },
];
---

<Base title="Toolbox">
  <header class="hero">
    <p class="mk-kicker">FROM THE MANAGEMENT</p>
    <h1>The Programme</h1>
    <p class="hero__lede">
      One toolkit and its troupe of packages — built once, billed nightly,
      and appearing in every production thereafter.
    </p>
  </header>

  <!-- The one art reveal the page is allowed: the company, from the pipeline. -->
  <figure class="mk-figure hero-figure">
    <div class="mk-thumb mk-thumb--video mk-curtain-in">
      <img src={art('hero-bow.jpg')} alt="The full company taking a bow at the footlights" />
    </div>
    <figcaption>THE COMPANY, TAKING ITS BOW · DRAWN BY THE PIPELINE, NOT BY HAND</figcaption>
  </figure>

  <hr class="mk-divider mk-divider--double" />

  <section aria-labelledby="how">
    <h2 id="how">How the House Is Built</h2>
    <p class="prose">
      Web platform first, framework never. Every act performs in Remix,
      Svelte, plain HTML, or whatever the next season brings — including
      server-rendered houses and houses with no JavaScript at all. Boring,
      durable stagecraft; nothing joins the bill before the pain that
      justifies it.
    </p>
  </section>

  <section aria-labelledby="tools">
    <h2 id="tools">On the Bill</h2>
    <ul class="tools">
      {tools.map((t) => (
        <li class="mk-card tools__item">
          <p class="tools__no">{t.no} · {t.status}</p>
          <a class="mk-link-reset tools__link" href={link(t.href)}>{t.name} →</a>
          <p class="tools__role">{t.role}</p>
          <p class="tools__desc">{t.desc}</p>
        </li>
      ))}
      <li class="mk-empty tools__slot">
        <span class="mk-empty__title">NO. 3</span>
        <span class="mk-empty__message">COMING SOON — THE REST OF THE BILL IS STILL BEING SET</span>
      </li>
    </ul>
  </section>

  <section aria-labelledby="get">
    <h2 id="get">Tickets</h2>
    <p class="prose">
      Every package publishes publicly under the
      <a href="https://www.npmjs.com/org/sethmakes">@sethmakes</a> npm scope.
      Admission is free.
    </p>
    <pre><code>pnpm add @sethmakes/tokens @sethmakes/css</code></pre>
  </section>

  <style>
    .hero {
      text-align: center;
      padding-block: var(--mk-space-lg) var(--mk-space-xs);
    }

    .hero-figure {
      max-width: 44rem;
      margin: var(--mk-space-xl) auto 0;
      text-align: center;
    }

    .hero__lede {
      font-family: var(--mk-font-body);
      font-style: italic;
      font-size: var(--mk-size-quote);
      color: var(--mk-color-text-secondary);
      max-width: 48ch;
      margin-inline: auto;
    }

    section + section {
      margin-top: var(--mk-space-3xl);
    }

    .prose {
      max-width: var(--mk-measure-prose);
    }

    .tools {
      list-style: none;
      margin: var(--mk-space-lg) 0 0;
      padding: 0;
      display: grid;
      gap: var(--mk-space-lg);
      grid-template-columns: 1fr;
    }

    .tools__item {
      display: flex;
      flex-direction: column;
      gap: var(--mk-space-xxs);
    }

    /* The bill number — a typewriter slug over the act's name. */
    .tools__no {
      margin: 0;
      font-family: var(--mk-font-typewriter);
      font-size: var(--mk-size-mono-sm);
      letter-spacing: var(--mk-track-bill-no);
      color: var(--mk-color-text-muted);
    }

    .tools__link {
      font-family: var(--mk-font-marquee);
      font-size: var(--mk-size-dept);
      color: var(--mk-color-heading);
      line-height: var(--mk-leading-tight);
    }

    .tools__link:hover {
      color: var(--mk-color-link-hover);
    }

    /* The role line — lowercase italic, as printed under a player's name. */
    .tools__role {
      margin: 0;
      font-family: var(--mk-font-body);
      font-style: italic;
      font-size: var(--mk-size-tagline);
      color: var(--mk-color-text-secondary);
    }

    .tools__desc {
      margin: 0;
      font-size: var(--mk-size-body-sm);
      color: var(--mk-color-text);
    }

    pre {
      overflow-x: auto;
    }

    @media (min-width: 740px) {
      .tools {
        grid-template-columns: 1fr 1fr;
      }

      .tools__slot {
        grid-column: 1 / -1;
      }
    }
  </style>
</Base>
