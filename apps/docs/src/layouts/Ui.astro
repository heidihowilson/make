---
import Base from './Base.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;

// Normalize: Astro's BASE_URL has no trailing slash when base is '/make',
// and base+path without a separator produced /makeicons/... 404s in prod.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const link = (path: string) => (base + path.replace(/^\//, '')).replace(/\/+/g, '/');
const current = Astro.url.pathname.replace(base, '/').replace(/\/+$/, '') || '/';

const subnav = [
  { href: '/ui', label: 'OVERVIEW' },
  { href: '/ui/components/typography', label: 'TYPE' },
  { href: '/ui/components/buttons', label: 'BUTTONS' },
  { href: '/ui/components/forms', label: 'FORMS' },
  { href: '/ui/components/surfaces', label: 'SURFACES' },
  { href: '/ui/components/feedback', label: 'FEEDBACK' },
  { href: '/ui/components/media', label: 'MEDIA' },
  { href: '/ui/tokens', label: 'TOKENS' },
  { href: '/ui/cheatsheet', label: 'CHEATSHEET' },
];
---

<Base title={title}>
  <slot name="head" slot="head" />
  <!-- Departments of the UI section, set as tabs on the ink rule. -->
  <nav class="mk-tabs ui-subnav" aria-label="sethmakes-ui">
    {subnav.map((item) => (
      <a
        href={link(item.href)}
        class:list={['mk-tabs__tab', { 'mk-tabs__tab--active': current === item.href }]}
        aria-current={current === item.href ? 'page' : undefined}
      >{item.label}</a>
    ))}
  </nav>
  <slot />

  <style>
    .ui-subnav {
      margin-bottom: var(--mk-space-2xl);
    }
  </style>
</Base>
