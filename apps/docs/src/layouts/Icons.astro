---
import Base from './Base.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;

// Normalize: Astro's BASE_URL has no trailing slash when base is '/make',
// and base+path without a separator produced /makeicons/... 404s in prod.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const link = (path: string) => (base + path.replace(/^\//, '')).replace(/\/+/g, '/');
const current = Astro.url.pathname.replace(base, '/').replace(/\/+$/, '') || '/';

const subnav = [
  { href: '/icons', label: 'OVERVIEW' },
  { href: '/icons/browse', label: 'BROWSE' },
];
---

<Base title={title}>
  <slot name="head" slot="head" />
  <!-- Departments of the icons section, set as tabs on the ink rule —
       mirrors Ui.astro's subnav. -->
  <nav class="mk-tabs icons-subnav" aria-label="sethmakes-icons">
    {subnav.map((item) => (
      <a
        href={link(item.href)}
        class:list={['mk-tabs__tab', { 'mk-tabs__tab--active': current === item.href }]}
        aria-current={current === item.href ? 'page' : undefined}
      >{item.label}</a>
    ))}
  </nav>
  <slot />

  <style>
    .icons-subnav {
      margin-bottom: var(--mk-space-2xl);
    }
  </style>
</Base>
