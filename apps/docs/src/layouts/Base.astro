---
import '@sethmakes/tokens/index.css';
import '@sethmakes/tokens/fonts.css';
import '@sethmakes/css/index.css';

interface Props {
  title: string;
}

const { title } = Astro.props;

// Normalize: Astro's BASE_URL has no trailing slash when base is '/make',
// and base+path without a separator produced /makeicons/... 404s in prod.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const link = (path: string) => (base + path.replace(/^\//, '')).replace(/\/+/g, '/');

// Normalize current path (strip base + trailing slash) for active-link compare.
const current = Astro.url.pathname.replace(base, '/').replace(/\/+$/, '') || '/';

// Toolbox-level nav; tool sections list their own pages. "ui" highlights
// for every page under /ui/.
const nav = [
  { href: '/ui', label: 'UI' },
  { href: '/icons', label: 'ICONS' },
];

const isActive = (href: string) =>
  current === href || (href !== '/' && current.startsWith(href + '/'));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · sethmakes</title>
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">SKIP TO THE MAIN ATTRACTION</a>
    <div class="mk-stage">
      <div class="mk-sheet">
        <header class="masthead">
          <p class="masthead__dateline">
            <span>THE TOOLKIT</span>
            <span>·</span>
            <span>APPEARING NIGHTLY</span>
            <span>·</span>
            <span>PRICE: FREE</span>
          </p>
          <a href={link('/')} class="mk-link-reset masthead__title" aria-current={current === '/' ? 'page' : undefined}>sethmakes</a>
          <p class="masthead__tagline">tools Seth uses when making things · est. 1983</p>
          <nav class="mk-appbar masthead__nav" aria-label="Primary">
            {nav.map((item) => (
              <a
                href={link(item.href)}
                class:list={['masthead__link', { 'masthead__link--active': isActive(item.href) }]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >{item.label}</a>
            ))}
          </nav>
        </header>

        <main id="main-content" class="site-main" tabindex="-1">
          <slot />
        </main>

        <footer class="site-foot">
          <span>SETHMAKES · SET IN SEPIA ON AGED NEWSPRINT</span>
          <nav class="site-foot__links" aria-label="Footer">
            <a href="https://github.com/heidihowilson/make">GITHUB</a>
            <a href="https://www.npmjs.com/org/sethmakes">@SETHMAKES</a>
          </nav>
        </footer>
      </div>
    </div>

    <style>
      /* Skip link — first focusable element; off-screen until focused. */
      .skip-link {
        position: absolute;
        left: 14px;
        top: 14px;
        z-index: 10;
        padding: 8px 14px;
        background: var(--mk-color-ink-surface);
        color: var(--mk-color-text-on-ink);
        font-family: var(--mk-font-typewriter);
        font-size: var(--mk-size-mono-sm);
        letter-spacing: var(--mk-track-back);
        transform: translateY(-250%);
      }

      .skip-link:focus {
        transform: translateY(0);
      }

      /* The masthead — dateline, Rye title, italic tagline, ruled nav. */
      .masthead {
        text-align: center;
      }

      .masthead__dateline {
        display: flex;
        justify-content: space-between;
        gap: 8px;
        margin: 0 0 10px;
        font-family: var(--mk-font-typewriter);
        font-size: var(--mk-size-mono-sm);
        letter-spacing: var(--mk-track-mono);
        color: var(--mk-color-text-secondary);
        border-bottom: var(--mk-rule-hair);
        padding-bottom: 8px;
      }

      .masthead__title {
        display: block;
        font-family: var(--mk-font-display);
        font-size: var(--mk-size-title);
        line-height: var(--mk-leading-tight);
        color: var(--mk-color-heading);
        margin: 6px 0 0;
      }

      .masthead__tagline {
        margin: 4px 0 14px;
        font-family: var(--mk-font-body);
        font-style: italic;
        font-size: var(--mk-size-tagline);
        color: var(--mk-color-text-secondary);
      }

      .masthead__nav {
        justify-content: center;
      }

      .masthead__link {
        color: var(--mk-color-heading);
      }

      .masthead__link:hover {
        color: var(--mk-color-link-hover);
        text-decoration: none;
      }

      /* The current section underlines itself with the department rule. */
      .masthead__link--active {
        border-bottom: 2px solid var(--mk-color-rule);
      }

      .site-main {
        padding-block: var(--mk-space-2xl) var(--mk-space-3xl);
      }

      /* The foot — a 3px double rule, slugs left and right. */
      .site-foot {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 8px var(--mk-space-2xl);
        border-top: var(--mk-rule-double-thin);
        padding-top: var(--mk-space-sm);
        font-family: var(--mk-font-typewriter);
        font-size: var(--mk-size-mono-sm);
        letter-spacing: 0.06em;
        color: var(--mk-color-text-muted);
      }

      .site-foot__links {
        display: flex;
        flex-wrap: wrap;
        gap: var(--mk-space-md);
      }

      @media (max-width: 740px) {
        .masthead__dateline {
          justify-content: center;
        }

        .site-foot {
          flex-direction: column;
          align-items: center;
          text-align: center;
        }
      }
    </style>
  </body>
</html>
